    {
      "id": "user-function",
      "definition_id": "user-function",
      "parameters": {
        "code": [
          "",
          "import numpy as np",
          "import pyxel as px",
          "from flowgraph.domain.mesh_document import  MeshDocument",
          "",
          "def Execute(image_reff, image_def, elementSize:int, regulLength: int, removeRigid:bool, zone) ->tuple[MeshDocument]:",
          "",
          "    f = px.Image('image_reff')",
          "    f.pix = np.asarray(image_reff).astype(float)",
          "    if len(f.pix.shape) == 3:",
          "        f.ToGray()",
          "    #f.Plot()",
          "    g = px.Image('image_def')",
          "    g.pix = np.asarray(image_def).astype(float)",
          "    if len(g.pix.shape) == 3:",
          "        g.ToGray()",
          "    #g.Plot()",
          "    ",
          "    roi = np.array(zone)",
          "    import Muscat.MeshContainers.ElementsDescription as ED",
          "    typel = {3: ED.Quadrangle_4,2: ED.Triangle_3,9: ED.Triangle_6,16: ED.Quadrangle_8,10: ED.Quadrangle_9}",
          "    print(\"----------------------------\")",
          "    print(roi)",
          "    print(elementSize)",
          "    m, cam = px.MeshFromROI(roi, elementSize, typel=2)",
          "    U, res = px.Correlate(f, g, m, cam)",
          "",
          "    from Muscat.MeshTools.MeshCreationTools import CreateMeshFromCellsDict",
          "    ",
          "",
          "    connectivity=  { typel[t]:m.e[t] for t in m.e.keys() }",
          "    outputmesh = CreateMeshFromCellsDict(points = np.ascontiguousarray(m.n), cellsDict = connectivity)",
          "    #U = U.copy().reshape(-1, 2)",
          "    print(outputmesh)",
          "    print(outputmesh.ComputeBoundingBox())",
          "    print(U.shape)",
          "    n = len(U)//2",
          "    outputmesh.nodeFields[\"U0\"] =U[:n]",
          "    outputmesh.nodeFields[\"U1\"] =U[n:]",
          "    outputmesh.nodeFields[\"U\"] =np.column_stack((U[:n],U[n:], np.zeros(n)))",
          "    ",
          "    ",
          "    return (MeshDocument(outputmesh),)",
          ""
        ],
        "__user_input__elementSize": 25,
        "__user_input__regulLength": 5,
        "__user_input__removeRigid": true
      },
