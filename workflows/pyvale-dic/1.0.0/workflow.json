    {
      "id": "read-image-1",
      "definition_id": "read-image",
      "parameters": {
        "path": "/tmp/flowgraph-user-data/heaviside_01.jpg"
      },
      "position": {
        "x": -444.5387237158226,
        "y": 711.4479882430339
      }
    },
    {
      "id": "user-function",
      "definition_id": "user-function",
      "parameters": {
        "code": [
          "import numpy as np",
          "from pyvale import dic",
          "from Muscat.MeshContainers import ElementsDescription as ED",
          "from Muscat.MeshTools.MeshCreationTools import CreateMeshFromCellsDict",
          "from flowgraph.domain.mesh_document import MeshDocument",
          "",
          "",
          "def Execute(image_reff, image_def, subsetSize: int, subsetStep: int,",
          "            maxDisplacement: int, threshold: float, zone) -> tuple[MeshDocument]:",
          "    \"\"\"Correlate in pixel coordinates and return a negative-Y display mesh.\"\"\"",
          "    def grayscale(image):",
          "        pixels = np.asarray(image, dtype=np.float64)",
          "        if pixels.ndim == 3 and pixels.shape[2] in (3, 4):",
          "            pixels = pixels[:, :, :3] @ np.array([0.299, 0.587, 0.114])",
          "        elif pixels.ndim == 3 and pixels.shape[2] == 1:",
          "            pixels = pixels[:, :, 0]",
          "        if pixels.ndim != 2 or not np.isfinite(pixels).all():",
          "            raise ValueError('Images must be finite grayscale, RGB or RGBA arrays.')",
          "        return np.ascontiguousarray(pixels)",
          "",
          "    reference, deformed = grayscale(image_reff), grayscale(image_def)",
          "    if reference.shape != deformed.shape:",
          "        raise ValueError('Reference and deformed images must have the same dimensions.')",
          "    if type(subsetSize) is not int or subsetSize < 5 or subsetSize % 2 != 1:",
          "        raise ValueError('subsetSize must be an odd integer of at least 5 pixels.')",
          "    if type(subsetStep) is not int or subsetStep < 1:",
          "        raise ValueError('subsetStep must be a positive integer.')",
          "    if type(maxDisplacement) is not int or maxDisplacement < 1:",
          "        raise ValueError('maxDisplacement must be a positive integer.')",
          "    if not np.isfinite(threshold) or not 0 < threshold < 1:",
          "        raise ValueError('threshold must lie strictly between 0 and 1.')",
          "    corners = np.asarray(zone, dtype=float)",
          "    if (corners.shape != (2, 2) or not np.isfinite(corners).all()",
          "            or not np.equal(corners, np.floor(corners)).all()):",
          "        raise ValueError('ROI must contain two integer (x, y) corners.')",
          "    x0, y0 = corners.min(axis=0).astype(int)",
          "    x1, y1 = corners.max(axis=0).astype(int)",
          "    height, width = reference.shape",
          "    if not (0 <= x0 < x1 < width and 0 <= y0 < y1 < height):",
          "        raise ValueError('ROI corners must be distinct and inside the reference image.')",
          "    if min(x1 - x0, y1 - y0) < subsetSize + 2 * subsetStep:",
          "        raise ValueError('ROI is too small for a 2D mesh; enlarge it or reduce subsetSize/subsetStep.')",
          "    if np.ptp(reference[y0:y1 + 1, x0:x1 + 1]) == 0:",
          "        raise ValueError('The reference ROI has no intensity variation to correlate.')",
          "    mask = np.zeros(reference.shape, dtype=bool)",
          "    mask[y0:y1 + 1, x0:x1 + 1] = True",
          "    # Image Y increases downward: bottom-left means small X and large Y.",
          "    # Leave room for the subset, neighbours and pyvale's seed-grid snapping.",
          "    inset = subsetSize // 2 + 2 * subsetStep",
          "    seed_x = min(x0 + inset, (x0 + x1) // 2)",
          "    seed_y = max(y1 - inset, (y0 + y1) // 2)",
          "    results = dic.calculate_2d(",
          "        reference=reference, deformed=deformed, roi_mask=mask,",
          "        seed=[int(seed_x), int(seed_y)],",
          "        subset_size=subsetSize, subset_step=subsetStep,",
          "        max_displacement=maxDisplacement, threshold=float(threshold),",
          "        correlation_criteria='ZNSSD', shape_function='AFFINE',",
          "        layout='COLUMN', output_results=False, output_below_threshold=True,",
          "        num_threads=1, print_level=0,",
          "    )",
          "    x, y = np.asarray(results.ss_x), np.asarray(results.ss_y)",
          "    u, v = np.asarray(results.u_px[0]), np.asarray(results.v_px[0])",
          "    cost = np.asarray(results.cost[0])",
          "    valid = (np.asarray(results.converged[0], dtype=bool)",
          "             & np.isfinite(u) & np.isfinite(v) & np.isfinite(cost)",
          "             & (cost >= threshold))",
          "    # Only connect adjacent subset centres with four valid corners. Never bridge",
          "    # a failed subset with a Delaunay triangle or replace a failure with zero.",
          "    lookup = {(int(px), int(py)): i for i, (px, py) in enumerate(zip(x, y)) if valid[i]}",
          "    cells = []",
          "    for (px, py), i in lookup.items():",
          "        adjacent = [(px, py + subsetStep),",
          "                    (px + subsetStep, py + subsetStep), (px + subsetStep, py)]",
          "        if all(point in lookup for point in adjacent):",
          "            cells.append([i] + [lookup[point] for point in adjacent])",
          "    if not cells:",
          "        raise ValueError('No valid 2D subset cells remain. Check texture, ROI and correlation settings.')",
          "    cells = np.asarray(cells, dtype=np.int64)",
          "    used, inverse = np.unique(cells, return_inverse=True)",
          "    points = np.ascontiguousarray(np.column_stack((x[used], -y[used], np.zeros(len(used)))))",
          "    mesh = CreateMeshFromCellsDict(",
          "        points=points, cellsDict={ED.Quadrangle_4: np.ascontiguousarray(inverse.reshape(-1, 4))})",
          "    # Negate vertical displacements too, so U is consistent with mesh geometry.",
          "    mesh.nodeFields['U0'] = u[used].copy()",
          "    mesh.nodeFields['U1'] = -v[used].copy()",
          "    mesh.nodeFields['U'] = np.column_stack((u[used], -v[used], np.zeros(len(used))))",
          "    mesh.nodeFields['v_image'] = v[used].copy()",
          "    mesh.nodeFields['cost'] = cost[used].copy()",
          "    mesh.nodeFields['converged'] = np.ones(len(used), dtype=float)",
          "    print(f'pyvale: {valid.sum()}/{len(valid)} valid subsets; {len(cells)} mesh cells.')",
          "    return (MeshDocument(mesh),)"
        ],
        "__user_input__subsetSize": 21,
        "__user_input__subsetStep": 10,
        "__user_input__maxDisplacement": 10,
        "__user_input__threshold": 0.9
      },
      "position": {
